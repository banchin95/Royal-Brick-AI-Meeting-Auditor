# Copy to /etc/royal-brick/backend.env, root:root, mode 600.
# Use an AI Gateway token, not the Timeweb VPS management token.
AI_PROVIDER=timeweb
TIMEWEB_AI_TOKEN=
TIMEWEB_MODEL=openai/gpt-5.4-mini
TIMEWEB_TRANSCRIPTION_MODEL=openai/gpt-4o-transcribe
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_OUTPUT_TOKENS=12000
TRANSCRIPTION_TIMEOUT_SECONDS=600
CORS_ORIGINS=https://@@DOMAIN@@
