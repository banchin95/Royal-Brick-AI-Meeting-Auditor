[Unit]
Description=Royal Brick Meeting Auditor API
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=royal-brick
Group=royal-brick
WorkingDirectory=/opt/royal-brick/current
EnvironmentFile=/etc/royal-brick/backend.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/royal-brick/current/backend/.venv/bin/python -m uvicorn backend.app.main:app --host 127.0.0.1 --port 8187 --workers 1 --no-access-log --no-proxy-headers
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CPUQuota=60%
CPUWeight=20
MemoryHigh=512M
MemoryMax=768M
TasksMax=64
LimitNOFILE=2048

[Install]
WantedBy=multi-user.target
